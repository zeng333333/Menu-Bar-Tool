set iplist "
10.8.30.16
10.8.30.19
10.8.30.22
10.8.30.14
10.8.30.20
10.8.30.17
10.8.30.23
10.8.30.21
10.8.30.18
"

set targetPath "/vault/ZJX_backup"

set password "gdlocal"
set username "gdlocal"
foreach ip $iplist {
	puts $ip
	# rsync 增量同步， --delete 删除本机文件夹没有的文件，确保目标文件夹内容与本机文件夹内容一致
	# set timeout 3
	spawn rsync -avhz --delete -e ssh $scriptDir/ZJX_backup/ $username@$ip:$targetPath

	expect {
	    "yes/no" {
	    	send "yes\r"; 
	    	exp_continue
		}
	    "Password:" {
	    	send "$password\r" 
	    }
	}

	set timeout -1
	expect "~ %"

}

# # 移除MacOS未知来源安全保护弹窗
set timeout 1
foreach ip $iplist {
 	spawn ssh -o StrictHostKeyChecking=no $username@$ip
 	# spawn ssh $username@$ip
 	expect "*assword*"
 	send "$password\r"



 	expect "~ %"
 	send "killall shTool\r"

 	expect "~ %"
 	send "open /vault/ZJX_backup/shTool.app/Contents/Resources/Tool/auto\r"
 	# send "open /vault/ZJX_backup/shTool.app\r"
 	# send "xattr -rd com.apple.quarantine $targetPath\r"
 	expect "~ %"

	send "cp -r /vault/ZJX_backup/MIX-Tool/ /Users/gdlocal/.MIX-Tool/\r"
	expect "~ %"

	send "exit\r"
	expect "~ %"
	
	#软链接
	# send "ln -s $targetPath ~/Desktop\r"
	# expect "~ %"
}


puts "\n\n 同步完成✅\n\n"
