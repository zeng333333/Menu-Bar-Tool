# 本脚本用于批量同步./tools 文件夹到多台电脑




# 获取当前脚本的路径，并规范为绝对路径
set scriptPath [file normalize [info script]]
file delete -force ~/.ssh/known_hosts
# 如果需要获取该脚本所在的目录
set scriptDir [file dirname $scriptPath]
cd "$scriptDir"



set iplist "
10.8.30.33
"
set iplist "
10.8.30.14
"


set targetPath "/System/Volumes/Data/vault/ZJX_BF"
set targetPath "/vault/ZJX_backup"
set targetPath "/Users/gdlocal/Library/Atlas2----doe1"
set targetPath "/Users/gdlocal/Library/1.zip"
set targetPath "/Users/gdlocal/Library/Atlas2"

set password "gdlocal"
set username "gdlocal"
foreach ip $iplist {
	puts $ip
	# rsync 增量同步， --delete 删除本机文件夹没有的文件，确保目标文件夹内容与本机文件夹内容一致
	# set timeout 3
	spawn rsync -avhz --delete -e ssh $username@$ip:$targetPath $scriptDir/Test/ 

	expect {
	    "yes/no" {
	    	send "yes\r"; 
	    	exp_continue
		}
	    "Password:" {
	    	send "$password\r" 
	    }
	}

	set timeout -1
	expect "~ %"

}

