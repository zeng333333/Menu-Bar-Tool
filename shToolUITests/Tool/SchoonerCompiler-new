debugPrint() {
    if [[ ${debuginfo} == "YES" ]]; then
        echo "Debug: $@"
    fi
}

func_file_type()
{
    file $1 | grep -q "arm64" && echo "arm64" || echo "x86_64"
}

func_sys_type()
{
    uname -m  | grep -q "arm64" && echo "arm64" || echo "x86_64"
}

func_cp_mooncake_0()
{
    dir_name=`dirname "$0"`
    if [[ $1 == "arm64" ]];then
        if [[ -e "$dir_name/arm64/mooncake_0.so" ]]; then
            cp "$dir_name/arm64/mooncake_0.so" "/Users/gdlocal/Library/Atlas2/Modules/Mooncake/mooncake_0.so"
            cp "$dir_name/arm64/mooncake.lua" "/Users/gdlocal/Library/Atlas2/Modules/Mooncake/mooncake.lua"
            debugPrint "[替换mooncake成功] cp $dir_name/arm64/mooncake_0.so" "/Users/gdlocal/Library/Atlas2/Modules/Mooncake/mooncake_0.so"
        else
            debugPrint "[替换mooncake失败]"
        fi
    fi
    if [[ $1 == "x86_64" ]];then
        if [[ -e "$dir_name/x86_64/mooncake_0.so" ]]; then
            cp "$dir_name/x86_64/mooncake_0.so" "/Users/gdlocal/Library/Atlas2/Modules/Mooncake/mooncake_0.so"
            cp "$dir_name/x86_64/mooncake.lua" "/Users/gdlocal/Library/Atlas2/Modules/Mooncake/mooncake.lua"
            debugPrint "[替换mooncake成功] cp $dir_name/x86_64/mooncake_0.so" "/Users/gdlocal/Library/Atlas2/Modules/Mooncake/mooncake_0.so"
        else
            debugPrint "[替换mooncake失败]"
        fi
    fi
}

func_backup_dir_if_exist(){
    dir_path=$1

    if [[ ! -e $dir_path ]]; then
        echo "[备  份] 文件不存在，跳过：$dir_path"
        return 0
    fi

    base_name=`basename $dir_path`
    dir_name=`dirname $dir_path`
    bakup_dir="${dir_name}/${base_name}_Backup"
    date_str=`date "+%Y%m%d%H%M%S"`
    target_dir="${bakup_dir}/${base_name}"

    echo "[备  份] 目录：$dir_path"
    if [[ ! -e $bakup_dir ]]; then
        echo "[创  建] 备份目录：$bakup_dir"
        mkdir $bakup_dir
    fi
    echo "[复 制] 目录：$dir_path -> $target_dir"
    cp -r $dir_path $target_dir
    echo "[切  换] 目录：${bakup_dir}"
    cd ${bakup_dir}
    echo "[压  缩] 目录：${base_name} -> ${base_name}_${date_str}.zip"
    zip -q -r "${base_name}_${date_str}.zip" ${base_name}
    rm -rf ${target_dir}
}

func_check_mooncake()
{
    if [[ -e "$mooncake_0_path" ]]; then
        SC="SC"
    else
        debugPrint "$mooncake_0_path No such file"
        exit
    fi

    if [[ $(func_file_type $mooncake_0_path) == $(func_sys_type) ]]; then
        SC="SC"
    else
        debugPrint "$(func_sys_type)"
        func_cp_mooncake_0 "$(func_sys_type)"
    fi
}

# 自动修复 "Test Condition:xxxx is not generated by any test" 错误
# 入参：$1=编译错误日志，$2=LimitsTable.csv 路径
# 返回：0=已删除对应记录并修复；1=无需修复或未找到记录
func_fix_test_condition_error(){
	error_log=$1
	limits_table=$2

	# 检查是否包含 "Test Condition:xxxx is not generated by any test" 错误
	if echo "$error_log" | grep -q "Test Condition:.*is not generated by any test"; then
		printf '\033[;33;1m'
		echo "[检测] 发现测试条件错误，开始自动修复..."
		printf '\033[0m'

		# 提取所有测试条件名称（兼容 macOS 和 Linux）
		# 使用 sed 提取 "Details: Test Condition:xxxx is not generated by any test" 中的 xxxx
		test_conditions=$(echo "$error_log" | grep "Details: Test Condition:" | sed -n 's/.*Details: Test Condition:\([^ ]*\) is not generated by any test.*/\1/p')

		if [ -z "$test_conditions" ]; then
			echo "[警告] 无法提取测试条件名称"
			return 1
		fi

		# 备份 LimitsTable.csv
		backup_file="${limits_table}.backup_$(date +%Y%m%d_%H%M%S)"
		cp "$limits_table" "$backup_file"
		echo "[备份] 已备份 LimitsTable.csv 到: $backup_file"

		# 处理每个测试条件
		fixed_count=0
		while IFS= read -r test_condition; do
			if [ -z "$test_condition" ]; then
				continue
			fi

			echo "[修复] 处理测试条件: $test_condition"

			# 检查是否存在
			matching_lines=$(grep -c "$test_condition" "$limits_table" 2>/dev/null || echo "0")

			if [ "$matching_lines" -gt 0 ]; then
				# 删除包含该测试条件的行
				temp_file=$(mktemp)
				grep -v "$test_condition" "$limits_table" > "$temp_file"
				mv "$temp_file" "$limits_table"
				echo "[删除] 已删除 $matching_lines 行包含 '$test_condition' 的记录"
				fixed_count=$((fixed_count + 1))
			else
				echo "[信息] LimitsTable.csv 中未找到包含 '$test_condition' 的行"
			fi
		done <<< "$test_conditions"

		if [ $fixed_count -gt 0 ]; then
			printf '\033[;32;1m'
			echo "[完成] 已修复 $fixed_count 个测试条件错误"
			printf '\033[0m'
			return 0
		else
			echo "[信息] 未找到需要删除的行"
			return 1
		fi
	else
		return 1
	fi
}

initializeCompilerPlist() {
    local file=$1
    # per man page, plutil is available since macos 10.2
    # ideall we can use the following line to create an empty plist
    # but later it is found that macOS 10.15 and 11.0 does not support `plutil -create`
    # while macOS 12.0 support this
    #  plutil -create xml1 "${file}"
    # so, use echo to create an empty json dict, and convert it into plist
    # to make it work in macOS 10.15+
    # TODO: if schooner is to support macOS 12.0+ someday, switch to `plutil -create` here.
    echo "{}" > "${file}" || exit $?
    plutil -convert xml1 "${file}" || exit $?
    # macOS 10.15 and 11.0 `plutil -insert` does not support -array and -dictionary. So
    # 2. use -json to insert table and array
    plutil -insert GroupArgs -json [] "${file}" || exit $?
    plutil -insert GroupArgs.0 -json {} "${file}" || exit $?
}

addPlistEntry() {
    local file="$1"
    local key="$2"
    local type="$3"
    local value="$4"
    if [[ ${type} == 'array' ]]; then
        # macOS 10.15 and 11.0 `plutil -insert` does not support -array and -dictionary. So
        # use -json to insert table and array
        plutil -insert GroupArgs.0.${key} -json "[${value}]" "${file}" || exit $?
    else
        # per man page, plutil is available since macos 10.2
        plutil -insert GroupArgs.0.${key} -${type} "${value}" "${file}" || exit $?
    fi
}

run() {
    local primary="${1}"
    # debugPrint "primary $primary"
    local secondary=("${@:2}")
    # debugPrint "secondary $secondary"
    local ret
    if [[ -z "${primary}" ]]; then
        echo 'No primary Atlas2 folder found. Schooner compiler needs at least 1 Atlas2 folder to compile. Exiting with -1.'
        exit
    fi

    local plistPath="${primary}${CompilerPlistPath}"
    echo "[修 改] 文件：${plistPath}"
    debugPrint "Generating compiler coreless plist to ${plistPath}"
    initializeCompilerPlist "${plistPath}"
    debugPrint "Setting primary Atlas2 folder: ${primary}"
    addPlistEntry "${plistPath}" PrimaryAtlas2 string "${primary}"

    # echo 'Running Schooner compiler'
    local entry
    entry="${primary}Modules/Schooner/Compiler/BuildSchoonerSequence.lua"
    mkdir -p "${primary}Modules/coverage"

    local limitsTable="${primary}Assets/Coverage/LimitsTable.csv"

    local max_retry=10
    local retry_count=0
    local compile_success=false

    while [[ ${retry_count} -lt ${max_retry} && "${compile_success}" == "false" ]]; do
        echo "[编  译] "${AtlasGroupProcess}" coreless "${entry}" "${plistPath}""
        ret=$(${AtlasGroupProcess} coreless "${entry}" "${plistPath}" 2>&1)

        if echo "$ret" | grep -qi -e "Error:" -e "MooncakeYAMLParser"; then
            # 仅当是测试条件错误时自动修复并重试，其他错误直接失败
            if func_fix_test_condition_error "$ret" "$limitsTable"; then
                retry_count=$((retry_count + 1))
                echo "[重试] 第 ${retry_count} 次重新编译..."
            else
                echo "$ret"
                break
            fi
        else
            compile_success=true
        fi
    done

    xattr -rc ${ATLAS2_FOLDER}
    echo "[xattr] xattr -rc ${ATLAS2_FOLDER}"
    
    if [[ "${compile_success}" == "true" ]]; then
        echo "[成 功] 编译成功 "
    else
        echo "[错 误] 编译失败，请检查错误信息"
    fi
    exit
}

main() {
    ATLAS2_FOLDER="/Users/$(whoami)/Library/Atlas2/"
    # 备份Atlas2
    func_backup_dir_if_exist ${ATLAS2_FOLDER}
    #检查当前文件mooncake的架构，不一致，自动替换
    func_check_mooncake
    #编译
    run ${ATLAS2_FOLDER}
}

main "${@}"

