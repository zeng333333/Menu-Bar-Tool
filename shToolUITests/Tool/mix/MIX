func_run_chmod(){
	# ==========给文件777权限==========
	script_path="${dir_name}/chmod.sh"
	# IP_SELECTION=$(osascript "$SCRIPT_PATH")
	IP_SELECTION=$(python3 "$SCRIPT_PATH_PY")
	# 处理结果
	if [ -z "$IP_SELECTION" ]; then
	    echo "未选择任何IP！"
	    exit 1
	fi
	# 拆分IP列表并输出
	IFS=',' read -ra IPS <<< "$IP_SELECTION"
	echo -e "\n✅ 选中的IP列表："
	for ip in "${IPS[@]}"; do
	    clean_ip=$(echo "$ip" | xargs)
	    echo "- $clean_ip"
	    cmd="${script_path} ${clean_ip}"
	    func_run_cmd2 ${cmd}
	done
}


func_check_IP()
{
    file $1 | grep -q "." && echo "YES" || echo "NO"
}

func_run_scp_push(){
	# ==========scp==========
	script_path="${dir_name}/auto_scp.sh"
	echo "例子：本地mix文件夹内容参考下面，保留需要修改的文件power.py以及这个文件所在的文件夹。脚本会把这个文件更新到远程mix对应的路径"
	echo '''mix
|____addon
| |____test_function
| | |____power.py'''
	while true; do
		# IP_SELECTION=$(osascript "$SCRIPT_PATH")
		IP_SELECTION=$(python3 "$SCRIPT_PATH_PY")
		ret=$(func_check_IP "$IP_SELECTION")
		if [[ ${ret} == "NO" ]]; then
		    echo "未选择任何IP！"
		    break
		fi
		if [[ ${ret} == "YES" ]]; then
			# 拆分IP列表并输出
			IFS=',' read -ra IPS <<< "$IP_SELECTION"
			echo -e "\n✅ 选中的IP列表："
			for ip in "${IPS[@]}"; do
			    clean_ip=$(echo "$ip" | xargs)
			    echo "- $clean_ip"
			done
			read -p "请输入本地mix文件路径:" local_file
			info=$(echo $local_file | grep -n "/mix")
			if [[ $info ]]; then
			    mix_path="/mix"
				read -p "是否重启，如果需要重启，请填入R或r或y或Y:" RFlag
				for ip in "${IPS[@]}"; do
				    clean_ip=$(echo "$ip" | xargs)
					cmd="${script_path} ${local_file} ${mix_path} ${clean_ip} ${RFlag}"
					func_run_cmd5 ${cmd}
				done
				break
			else
				echo "请输入正确mix文件夹路径"
				break
			fi
		fi
	done
	exit 0
}

