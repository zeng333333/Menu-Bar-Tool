# ========== 入口逻辑 ==========

case_type=$(cat /tmp/mix.txt 2>/dev/null)

if [ -n "$case_type" ]; then
    # 主路径：config.json → /tmp/mix.txt → ip_selector模式
    echo $case_type
    if [ "$case_type" = "1" ]; then
        echo "==========给文件777权限=========="
        func_run_chmod
    elif [ "$case_type" = "2" ]; then
        echo "==========拉取mix代码到Downloads=========="
        func_run_scp_get_mix
    elif [ "$case_type" = "3" ]; then
        echo "==========拉取mixlog到Downloads=========="
        func_run_scp_get_log
    elif [ "$case_type" = "4" ]; then
        echo "==========推送本地文件到MIX=========="
        func_run_scp_push
    elif [ "$case_type" = "5" ]; then
        echo "===========更新MIXbundle=========="
        func_run_update_mixbundle
    fi
else
    # 备用路径：交互菜单 → slot模式
    while true; do
        show_menu
        read -p "请输入功能编号: " choice
        case $choice in
            1) func_run_chmod_slot ;;
            2) func_run_scp_put_slot ;;
            3) func_run_scp_get_log_slot ;;
            4) func_run_scp_get_mix_slot ;;
            5) func_run_update_mixbundle ;;
            0) echo "${RED}退出系统中...${RESET}"; exit 0 ;;
            *) echo "${RED}无效输入，请重新选择${RESET}"; sleep 1 ;;
        esac
    done
fi
