SCRIPT_PATH="$dir_name/ip_selector.scpt"
SCRIPT_PATH_PY="$dir_name/ip_selector_tk.py"

echo "不同项目,需要配置不同的ip_selector内容"

# 通道→IP映射（备用slot模式使用，不同项目请配置此函数）
# 返回格式: IP-version（如 111.111.111.32-mix8）
fun_get_ip()
{
    slot=$1
    ip=$(($slot + 31))
    echo "111.111.111.$ip-mix8"
}

# ========== osascript 命令封装 ==========
func_run_cmd2(){
    cmd="$1 $2"
    echo $cmd
    osascript -e "tell app \"Terminal\" to do script \"${cmd}\""
}
func_run_cmd3(){
    cmd="$1 $2 $3"
    echo $cmd
    osascript -e "tell app \"Terminal\" to do script \"${cmd}\""
}
func_run_cmd4(){
    cmd="$1 $2 $3 $4"
    echo $cmd
    osascript -e "tell app \"Terminal\" to do script \"${cmd}\""
}
func_run_cmd5(){
    cmd="$1 $2 $3 $4 $5"
    echo $cmd
    osascript -e "tell app \"Terminal\" to do script \"${cmd}\""
}
func_run_cmd6(){
    cmd="$1 $2 $3 $4 $5 $6"
    echo $cmd
    osascript -e "tell app \"Terminal\" to do script \"${cmd}\""
}

func_check_IP()
{
    file $1 | grep -q "." && echo "YES" || echo "NO"
}

# ========== ip_selector 模式（主路径，config.json触发）==========

func_run_chmod(){
    script_path="${dir_name}/chmod.sh"
    IP_SELECTION=$(python3 "$SCRIPT_PATH_PY")
    if [ -z "$IP_SELECTION" ]; then
        echo "未选择任何IP！"
        exit 1
    fi
    IFS=',' read -ra IPS <<< "$IP_SELECTION"
    echo -e "\n✅ 选中的IP列表："
    for ip in "${IPS[@]}"; do
        clean_ip=$(echo "$ip" | xargs)
        echo "- $clean_ip"
        cmd="${script_path} ${clean_ip}"
        func_run_cmd2 ${cmd}
    done
}

func_run_scp_push(){
    script_path="${dir_name}/auto_scp.sh"
    echo "例子：本地mix文件夹内容参考下面，保留需要修改的文件power.py以及这个文件所在的文件夹。脚本会把这个文件更新到远程mix对应的路径"
    echo '''mix
|____addon
| |____test_function
| | |____power.py'''
    while true; do
        IP_SELECTION=$(python3 "$SCRIPT_PATH_PY")
        ret=$(func_check_IP "$IP_SELECTION")
        if [[ ${ret} == "NO" ]]; then
            echo "未选择任何IP！"
            break
        fi
        if [[ ${ret} == "YES" ]]; then
            IFS=',' read -ra IPS <<< "$IP_SELECTION"
            echo -e "\n✅ 选中的IP列表："
            for ip in "${IPS[@]}"; do
                clean_ip=$(echo "$ip" | xargs)
                echo "- $clean_ip"
            done
            read -p "请输入本地mix文件路径:" local_file
            info=$(echo $local_file | grep -n "/mix")
            if [[ $info ]]; then
                mix_path="/mix"
                read -p "是否重启，如果需要重启，请填入R或r或y或Y:" RFlag
                for ip in "${IPS[@]}"; do
                    clean_ip=$(echo "$ip" | xargs)
                    cmd="${script_path} ${local_file} ${mix_path} ${clean_ip} ${RFlag}"
                    func_run_cmd5 ${cmd}
                done
                break
            else
                echo "请输入正确mix文件夹路径"
                break
            fi
        fi
    done
    exit 0
}

