echo "不同项目,需要配置不同的ip_selector内容"
fun_get_ip()
{
	slot=$1
	ip=$(($slot + 31)) 
	echo "111.111.111.$ip"
}

func_run_cmd2(){
	cmd="$1 $2"
 	echo $cmd
	osascript -e "tell app \"Terminal\" to do script \"${cmd}\""
}

func_run_cmd3(){
	cmd="$1 $2 $3"
