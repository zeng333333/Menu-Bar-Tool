# ========== slot 模式（备用路径，交互菜单触发）==========

func_run_chmod_slot(){
    script_path="${dir_name}/chmod.sh"
    echo "输入数字N，表示选择第N通道。如:8,表示第8通道"
    echo "输入A+数字N，表示选择1~N通道。如:A8,表示选择1~8通道"
    while true; do
        read -p "请输入需要操作的通道数:" slot
        if [[ $slot == *[aA]* ]];then
            num=$(echo "$slot" | tr -d -c '0-9')
            if [[ -z "$num" || ! "$num" =~ ^[0-9]+$ ]]; then
                test=1
            else
                for (( i = 1; i <= $num; i++ )); do
                    IP=$(fun_get_ip $i)
                    cmd="${script_path} ${IP}"
                    func_run_cmd2 ${cmd}
                done
                break
            fi
        else
            if [[ "$slot" =~ ^[0-9]+$ ]]; then
                IP=$(fun_get_ip $slot)
                cmd="${script_path} ${IP}"
                func_run_cmd2 ${cmd}
                break
            fi
        fi
    done
}

