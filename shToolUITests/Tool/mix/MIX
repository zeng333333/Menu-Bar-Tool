# ========== 共享（slot模式，两种路径都用）==========

func_run_update_mixbundle(){
    script_path="${dir_name}/Update"
    echo "输入数字N，表示选择第N通道。如:8,表示第8通道"
    echo "输入A+数字N，表示选择1~N通道。如:A8,表示选择1~8通道"
    while true; do
        read -p "请输入需要操作的通道数:" slot
        if [[ $slot == *[aA]* ]];then
            num=$(echo "$slot" | tr -d -c '0-9')
            if [[ -z "$num" || ! "$num" =~ ^[0-9]+$ ]]; then
                test=1
            else
                read -p "请输入mixbundle路径:" mixbundle_path
                for (( i = 1; i <= $num; i++ )); do
                    IP=$(fun_get_ip $i)
                    IP_clean=${IP%%-*}
                    cmd="${script_path} ${mixbundle_path} ${IP_clean}"
                    func_run_cmd3 ${cmd}
                done
                break
            fi
        else
            if [[ "$slot" =~ ^[0-9]+$ ]]; then
                read -p "请输入mixbundle路径:" mixbundle_path
                IP=$(fun_get_ip $slot)
                IP_clean=${IP%%-*}
                cmd="${script_path} ${mixbundle_path} ${IP_clean}"
                func_run_cmd3 ${cmd}
                break
            fi
        fi
    done
}

