[
    {
        "menu_name": "运行-SchoonerCompile",
        "cmd": "open $(pwd)/Tool/SchoonerCompiler-new"
    },
    {
        "menu_name": "机台-out",
        "cmd": "rm /tmp/FixtureControlCore.txt ; echo out >>/tmp/FixtureControlCore.txt ; open  $(pwd)/Tool/RPC_/FixtureContro"
    },
    {
        "menu_name": "机台-in",
"cmd": "rm /tmp/FixtureControlCore.txt ; echo in >>/tmp/FixtureControlCore.txt ; open  $(pwd)/Tool/RPC_/FixtureContro"
    },
    {
        "menu_name": "机台-up",
"cmd": "rm /tmp/FixtureControlCore.txt ; echo up >>/tmp/FixtureControlCore.txt ; open  $(pwd)/Tool/RPC_/FixtureContro"
    },
    {
        "menu_name": "机台-down",
"cmd": "rm /tmp/FixtureControlCore.txt ; echo down >>/tmp/FixtureControlCore.txt ; open  $(pwd)/Tool/RPC_/FixtureContro"
    },
    {
        "menu_name": "机台-release",
"cmd": "rm /tmp/FixtureControlCore.txt ; echo release >>/tmp/FixtureControlCore.txt ; open  $(pwd)/Tool/RPC_/FixtureContro"
    },
    {
        "menu_name": "机台-press",
"cmd": "rm /tmp/FixtureControlCore.txt ; echo press >>/tmp/FixtureControlCore.txt ; open  $(pwd)/Tool/RPC_/FixtureContro"
    },
    {
        "menu_name": "打开-Atlas2软体路径",
        "cmd": "open ~/Library/Atlas2"
    },
    {
        "menu_name": "打开-Atlas2-log路径",
        "cmd": "open ~/Library/Logs/Atlas"
    },
    {
        "menu_name": "打开-Atlas2",
        "cmd": "$(pwd)/Tool/start_Atlas2"
    },
    {
        "menu_name": "打开-AtlasSignerTool",
        "cmd": "open $(pwd)/AtlasSigner/main"
    },
    {
        "menu_name": "MIX-登陆MIX",
"cmd": "rm /tmp/mix.txt ; echo 1 >>/tmp/mix.txt ; open  $(pwd)/Tool/mix/MIX"
    },
    {
        "menu_name": "MIX-拉取完整代码",
"cmd": "rm /tmp/mix.txt ; echo 2 >>/tmp/mix.txt ; open  $(pwd)/Tool/mix/MIX"
    },
    {
        "menu_name": "MIX-拉取Log",
"cmd": "rm /tmp/mix.txt ; echo 3 >>/tmp/mix.txt ; open  $(pwd)/Tool/mix/MIX"
    },
    {
        "menu_name": "MIX-推送本地文件到MIX",
"cmd": "rm /tmp/mix.txt ; echo 4 >>/tmp/mix.txt ; open  $(pwd)/Tool/mix/MIX"
    },
    {
        "menu_name": "MIX-更新mixbundle",
"cmd": "rm /tmp/mix.txt ; echo 5 >>/tmp/mix.txt ; open  $(pwd)/Tool/mix/MIX"
    },
    {
        "menu_name": "打开AtlasDataProcessorPlus",
        "cmd": "open  $(pwd)/../../../shTool/AtlasDataProcessorPlus.app"
    },
    {
        "menu_name": "打开MIX-Debug",
        "cmd": "open  $(pwd)/../../../shTool/MIX-Debug.app"
    },
    {
        "menu_name": "打开AtlasLogToCSV",
        "cmd": "open  $(pwd)/../../../shTool/AtlasLogToCSV.app"
    },
    {
        "menu_name": "打开SublimeText",
        "cmd": "open  $(pwd)/../../../shTool/SublimeText.app"
    },
    {
        "menu_name": "查看当前版本",
        "cmd": "open $(pwd)/Tool/Version"
    }
]